<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de la aplicación -->
    <style name="Base.Theme.HotelSys" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Asignación de colores de la marca al tema -->
        <item name="colorPrimary">@color/hotelsys_azul_marca</item>
        <item name="colorPrimaryVariant">@color/hotelsys_azul_oscuro</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/hotelsys_acento_cyan</item>
        <item name="colorSecondaryVariant">@color/hotelsys_acento_cyan</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:colorBackground">@color/hotelsys_fondo</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/hotelsys_texto_principal</item>

        <!-- Color de la barra de estado -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.HotelSys" parent="Base.Theme.HotelSys" />
</resources>