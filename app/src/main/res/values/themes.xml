<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de la aplicación -->
    <style name="Base.Theme.HotelSys" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Colores Primarios (para barras, botones principales) -->
        <item name="colorPrimary">@color/hotel_azul</item>
        <item name="colorPrimaryVariant">@color/hotel_azul_oscuro</item>
        <item name="colorOnPrimary">@color/white</item> <!-- Color del texto sobre el color primario -->

        <!-- Colores Secundarios (para acentos, estrellas, checkboxes, FAVs) -->
        <item name="colorSecondary">@color/hotel_acento</item>
        <item name="colorSecondaryVariant">@color/hotel_acento</item>
        <item name="colorOnSecondary">@color/black</item> <!-- Color del texto sobre el color secundario -->

        <!-- Colores de Fondo y Superficies -->
        <item name="android:colorBackground">@color/fondo_app</item>
        <item name="colorSurface">@color/white</item> <!-- Color de las tarjetas (cards) -->
        <item name="colorOnSurface">@color/texto_principal</item> <!-- Color del texto sobre las tarjetas -->

        <!-- Color de la barra de estado -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.HotelSys" parent="Base.Theme.HotelSys" />
</resources>