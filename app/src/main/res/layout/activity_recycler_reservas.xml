<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#E3E7F3"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1E3C72"
        android:gravity="center">

        <TextView
            android:id="@+id/tvTituloReservas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis Reservas"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerReservas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:clipToPadding="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverIndex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Regresar al Inicio"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#1E3C72"
            android:layout_margin="16dp" />
    </LinearLayout>
</LinearLayout>
